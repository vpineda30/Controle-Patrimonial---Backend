generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    String   @id @default(uuid())
  email String @unique
  name  String
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}